# Machine-specific settings.  Copy this file to env.local.sh (git ignores
# it) and uncomment what your machine needs:
#
#   cp env.local.sh.example env.local.sh
#
# Everything here is optional.  Use the ${VAR:-...} form so that a value
# given on the make command line still wins.

# gem5 checkout to build against.  Default: third_party/gem5, which
# `make gem5` clones (release v25.1.0.1) and patches.  An existing checkout
# of that release works too; `make gem5` applies the patch to it.
# export GEM5_DIR="${GEM5_DIR:-$HOME/gem5}"

# Python with the packages in requirements.txt (default: .venv from
# `make venv` if it exists, else python3).
# export PYTHON="${PYTHON:-$HOME/anaconda3/bin/python3}"

# RISC-V Linux cross-compiler for the host program.  Default: the first of
# riscv64-linux-gnu-gcc, third_party/zig-venv (make zig) and
# ~/riscv-tools/venv (pip install ziglang) that exists.
# export RISCV_CC="${RISCV_CC:-riscv64-linux-gnu-gcc -march=rv64gc}"

# Where make data / make figures write (default: results/ here, which git
# ignores), and the reference folder make check compares with.
# export RESULTS_DIR="${RESULTS_DIR:-$HOME/project-docs/results}"
# export CHECK_REF="${CHECK_REF:-$HOME/project-docs/results}"

# Parallel jobs: SIM_JOBS gem5 runs at once (default: 12, or nproc - 2 on
# smaller machines), BUILD_JOBS compile jobs (default: nproc - 2).
# export SIM_JOBS="${SIM_JOBS:-8}"
# export BUILD_JOBS="${BUILD_JOBS:-8}"

# Compilers and Python for building gem5.  scripts/build_gem5.sh calls this
# function, if it exists, just before scons.  Without it, gem5 is built
# with the system gcc/g++ and the python3-config on PATH (Ubuntu:
# sudo apt install build-essential scons python3-dev zlib1g-dev
# libprotobuf-dev protobuf-compiler m4).
#
# Example: a conda environment with Python 3.10, used without
# `conda activate` so that it also works in scripts.
#
# gem5_build_env() {
#     local env="$HOME/anaconda3/envs/gem5-env"
#     unset CPATH LIBRARY_PATH LD_LIBRARY_PATH LDFLAGS CPPFLAGS
#     export CONDA_PREFIX="$env"
#     export CPATH="$env/include" LIBRARY_PATH="$env/lib"
#     export LD_LIBRARY_PATH="$env/lib" LDFLAGS="-L$env/lib"
#     export CPPFLAGS="-I$env/include" PKG_CONFIG_PATH="$env/lib/pkgconfig"
#     export PATH="$env/bin:$PATH"
#     hash -r
# }
